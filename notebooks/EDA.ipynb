   "source": [
    "# Correlação de Spearman entre as variáveis numéricas e o default\n",
    "numeric_cols = df_unique.select_dtypes(include=['float64', 'int64']).columns.tolist()\n",
    "if 'default' not in numeric_cols:\n",
    "    numeric_cols.append('default')\n",
    "df_corr = df_unique[numeric_cols].copy()\n",
    "corr_matrix = df_corr.corr(method='spearman')\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.heatmap(corr_matrix, cmap='coolwarm', center=0, linewidths=0.5)\n",
    "plt.title('Correlação de Spearman entre variáveis numéricas')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "corr_default = corr_matrix['default'].drop('default').sort_values(key=lambda x: x.abs(), ascending=False)\n",
    "display(corr_default.head(10))\n"
   ]
